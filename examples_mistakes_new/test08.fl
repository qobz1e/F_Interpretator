(func map (f lst)
  (cond (isnull lst) (quote ())
        (cons (f (head lst)) (map f (tail lst)))))
(map (lambda (x) (times x x)) (quote (1 2 3)))

(func filter (pred lst)
  (cond (isnull lst) (quote ())
        (pred (head lst)) (cons (head lst) (filter pred (tail lst)))
        (filter pred (tail lst))))
(filter (lambda (x) (greater x 2)) (quote (1 2 3 4)))