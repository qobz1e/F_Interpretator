(func evalexpr (expr)
  (cond (isint expr) expr)
  (cond (islist expr) 
      ((cond (equal (head expr) (quote plus)) (plus (evalexpr (head (tail expr))) (evalexpr (head (tail (tail expr))))))
       (cond (equal (head expr) (quote times)) (times (evalexpr (head (tail expr))) (evalexpr (head (tail (tail expr))))))
       (cond (equal (head expr) (quote minus)) (minus (evalexpr (head (tail expr))) (evalexpr (head (tail (tail expr))))))
        expr)
    expr))

(evalexpr (quote (plus (times 2 3) 4)))