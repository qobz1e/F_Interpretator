(func compose (f g)
  (lambda (x) (f (g x))))
(setq addone (lambda (x) (plus x 1)))
(setq square (lambda (x) (times x x)))
(setq addsquare (compose addone square))
(addsquare 3)

(func partial (f a)
  (lambda (b) (f a b)))
(setq add (lambda (x y) (plus x y)))
(setq addfive (partial add 5))
(addfive 3)